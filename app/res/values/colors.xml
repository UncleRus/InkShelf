<?xml version="1.0" encoding="utf-8"?>
<!--
  Палитра e-ink: только чёрное/белое и оттенки серого. Цвета не используются
  намеренно — на grayscale-экране цветная подсветка выглядит грязно и повышает
  расход на перерисовку. Высокий контраст: ink на paper.
-->
<resources>
    <color name="paper">#FFFFFFFF</color>
    <color name="ink">#FF000000</color>

    <!-- Вторичный/третичный текст -->
    <color name="ink_secondary">#FF444444</color>
    <color name="ink_faint">#FF777777</color>

    <!-- Обводка иконок (drawable/ic_*). Чёрный вариант — через android:tint. -->
    <color name="icon">#FF444444</color>

    <!-- Разделители и состояния строк -->
    <color name="divider">#FFB8B8B8</color>
    <color name="divider_strong">#FF666666</color>
    <color name="row_pressed">#FFD0D0D0</color>
    <color name="row_selected">#FFC8C8C8</color>

    <!-- Счётчики/бейджи: белый фон + чёрная рамка (см. bg_badge) -->
    <color name="badge_bg">#FFFFFFFF</color>
    <color name="badge_ink">#FF000000</color>

    <!-- Плейсхолдер обложки: белый фон, рамка #666, чёрная буква -->
    <color name="placeholder_bg">#FFFFFFFF</color>
    <color name="placeholder_border">#FF666666</color>
    <color name="placeholder_ink">#FF000000</color>

    <!-- Раздел-заголовок (буква/дата/серия) в списках: белый текст на сером #808080 -->
    <color name="section_bg">#FF808080</color>

    <!-- Вкладки: активная — инвертирована (белый текст/иконка на чёрном) -->
    <color name="tab_active_bg">#FF000000</color>
    <color name="tab_active_ink">#FFFFFFFF</color>
    <color name="tab_inactive_ink">#FF333333</color>

    <!-- Поле поиска -->
    <color name="input_bg">#FFFFFFFF</color>
    <color name="input_hint">#FF777777</color>

    <!-- Баннеры/статусы -->
    <color name="banner_bg">#FFF2F2F2</color>
    <color name="banner_ink">#FF000000</color>

    <!-- Кнопки: белый фон + чёрная рамка (см. bg_button) -->
    <color name="button_bg">#FFFFFFFF</color>
    <color name="button_bg_pressed">#FFD0D0D0</color>
    <color name="button_bg_disabled">#FFEDEDED</color>
    <color name="button_ink">#FF000000</color>
    <color name="button_border">#FF000000</color>

    <!-- Недоступная книга -->
    <color name="disabled_ink">#FF8A8A8A</color>

    <!-- Постоянный скроллбар карточки книги (S3): серая дорожка, тёмный бегунок -->
    <color name="scrollbar_track">#FFD8D8D8</color>
    <color name="scrollbar_thumb">#FF3A3A3A</color>
</resources>
