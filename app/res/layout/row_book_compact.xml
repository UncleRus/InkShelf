<?xml version="1.0" encoding="utf-8"?>
<!--
  Компактная строка книги (плотность списка S4.4 «компактный», макет 03).
  Отличие от row_book.xml: обложка-плейсхолдер меньше (cover_w_compact ×
  cover_h_compact) и меньше вертикальные отбивки — в экран влезает больше книг.
  NFR-1 сохраняется: без maxLines/ellipsize, высота только wrap_content.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/space_xs"
    android:paddingBottom="@dimen/space_xs">

    <FrameLayout
        android:id="@+id/book_cover_box"
        android:layout_width="@dimen/cover_w_compact"
        android:layout_height="@dimen/cover_h_compact"
        android:background="@drawable/bg_letter">

        <ImageView
            android:id="@+id/book_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/book_letter"
            style="@style/Text.PlaceholderLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/book_title"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/book_sub"
            style="@style/Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            android:id="@+id/book_meta"
            style="@style/Text.Count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />
    </LinearLayout>
</LinearLayout>
