<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка читалки в D1/D1·b (макеты 16/25): иконка, название, метка
  «по умолчанию» (скрыта для остальных), радио текущего выбора.
  NFR-1: высота только wrap_content, без обрезки текста.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row.Dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/reader_icon"
        android:layout_width="@dimen/reader_icon"
        android:layout_height="@dimen/reader_icon"
        android:scaleType="fitCenter"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/reader_name"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_m" />

    <TextView
        android:id="@+id/reader_default"
        style="@style/Text.Count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_s"
        android:text="@string/reader_default_mark"
        android:visibility="gone" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/reader_radio"
        android:layout_width="@dimen/reader_radio"
        android:layout_height="@dimen/reader_radio"
        android:src="@drawable/ic_radio_off"
        android:contentDescription="@null" />
</LinearLayout>
