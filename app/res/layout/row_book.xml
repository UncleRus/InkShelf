<?xml version="1.0" encoding="utf-8"?>
<!--
  Строка книги. Обложка (V1, решение №19): миниатюра cover_w × cover_h; пока
  миниатюра не загружена или обложки нет — рамка-плейсхолдер с буквой названия.
  NFR-1: ни одна строка не обрезается — без maxLines/ellipsize, высота только
  wrap_content.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/book_cover_box"
        android:layout_width="@dimen/cover_w"
        android:layout_height="@dimen/cover_h"
        android:background="@drawable/bg_letter">

        <ImageView
            android:id="@+id/book_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/book_letter"
            style="@style/Text.PlaceholderLetter"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_m"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/book_title"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/book_sub"
            style="@style/Text.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />

        <TextView
            android:id="@+id/book_meta"
            style="@style/Text.Count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />
    </LinearLayout>
</LinearLayout>
