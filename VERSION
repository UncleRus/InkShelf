# Версия приложения — единственный источник истины (правка оператора 2026-11-18:
# бамп не должен требовать перебора мест). Отсюда её берут:
#   build.sh        — aapt2 link --version-name/--version-code → сам APK
#   design/gen.py   — макеты S6 «Диагностика» («0.1.2 (3)») и S7 «О программе»
#   build.sh (dist) — имя артефакта dist/InkShelf-<name>-<code>.apk
# Приложение показывает то, что влито в APK (PackageInfo), поэтому правка этого
# файла и есть бамп версии. name — строка для человека, code — целое для
# обновлений (install -r принимает только рост code).
name=0.1.2
code=3
